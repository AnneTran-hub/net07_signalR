@page "/home"
@implements IAsyncDisposable
@inject IProductService ProductService
@inject IJSRuntime JS

<PageTitle>Shoes store</PageTitle>

<div class="container-fluid store-page">
    <h1 class="store-title">Shoes store</h1>
    <div class="row g-3">
        <aside class="col-12 col-md-4 mb-4">
            <div class="list-group">
                @foreach (var category in categories)
                {
                    <button class="list-group-item list-group-item-action @(selectedCategory == category ? "active" : "")"
                            @onclick="() => SelectCategory(category)">
                        @category
                    </button>
                }
            </div>
        </aside>

        <section class="col-12 col-md-8">
            <div class="row g-3">
                @foreach (var product in FilteredProducts)
                {
                    <div class="col-12 col-sm-6 col-md-4">
                        <div class="card h-100 shadow-sm">
                            <div class="product-image @product.Image" role="img" aria-label="@product.Name"></div>
                            <div class="card-body d-flex flex-column">
                                <h6 class="card-title text-lowercase">@product.Name</h6>
                                <p class="card-text text-muted mb-2">Price: @product.Price.ToString("0")</p>
                                <button class="btn btn-dark btn-sm mt-auto align-self-start" @onclick="() => ShowDetail(product)">
                                    Detail
                                </button>
                            </div>
                        </div>
                    </div>
                }

                @if (!FilteredProducts.Any())
                {
                    <p class="text-muted">Không tìm thấy sản phẩm phù hợp.</p>
                }
            </div>
        </section>
    </div>
</div>

@if (detailProduct is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@detailProduct.Name</h5>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <div class="product-image @detailProduct.Image mb-3" role="img" aria-label="@detailProduct.Name"></div>
                    <p><strong>Alias:</strong> @detailProduct.Alias</p>
                    <p><strong>Price:</strong> @detailProduct.Price.ToString("0")</p>
                    <p><strong>Description:</strong> @detailProduct.Description</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseDetail">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "search")]
    public string SearchTerm { get; set; } = string.Empty;

    private string? selectedCategory;
    private ProductDto? detailProduct;
    private DotNetObjectReference<Home>? _dotNetRef;
    private List<string> categories = new();
    private List<ProductDto> products = new();

    protected override void OnInitialized() => LoadProducts();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("productHub.start", _dotNetRef);
        }
    }

    [JSInvokable]
    public async Task OnProductsChanged()
    {
        LoadProducts();
        await InvokeAsync(StateHasChanged);
    }

    private void LoadProducts()
    {
        products = ProductService.GetAll().ToList();
        categories = new[] { "Adidas", "Nike", "Converse" }
            .Where(category => products.Any(product => product.Category == category))
            .ToList();
    }

    private IEnumerable<ProductDto> FilteredProducts =>
        products.Where(p =>
            (selectedCategory is null || p.Category == selectedCategory) &&
            (string.IsNullOrWhiteSpace(SearchTerm) || p.Name.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)));

    private void SelectCategory(string? category) => selectedCategory = category;

    private void ShowDetail(ProductDto product) => detailProduct = product;

    private void CloseDetail() => detailProduct = null;

    public async ValueTask DisposeAsync()
    {
        if (_dotNetRef is not null)
        {
            try { await JS.InvokeVoidAsync("productHub.stop"); } catch { }
            _dotNetRef.Dispose();
        }
    }
}
